# Copy this file to .env and fill in your key. Never commit .env.
# Get a key at https://console.anthropic.com (API Keys page).
ANTHROPIC_API_KEY=

# Optional. Which Claude model to use and how hard it should think.
# Models: claude-opus-5-5 (most capable), claude-sonnet-5-5, claude-haiku-5-5 (cheapest)
ANTHROPIC_MODEL=claude-opus-5-5
# Effort: low | medium | high
ANTHROPIC_EFFORT=medium

# Optional. Where the app stores data. Defaults to a local file in data/ (ignored by Git).
# To use a hosted database later (e.g. Turso), set both of these.
# DATABASE_URL=file:data/app.db
# DATABASE_AUTH_TOKEN=
